# Pick ONE text-provider key below (DeepSeek, OpenCode Go, or GLM) — the proxy
# uses whichever is set. If more than one is set, priority is:
# OpenCode Go > GLM > DeepSeek.

# DeepSeek API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenCode API Key (https://opencode.ai)
OPENCODE_API_KEY=your_opencode_api_key_here

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# GLM / Z.ai API Key (https://z.ai — GLM Coding Plan)
GLM_API_KEY=your_glm_api_key_here

# Google AI Studio / Gemini API Key (https://aistudio.google.com/apikey — free tier)
# The image path: it reads the pictures in a request and the text provider
# writes the reply. It is not a text provider itself — that is Google
# Antigravity, below.
GEMINI_API_KEY=your_gemini_api_key_here

# Google Antigravity OAuth client — needed only to connect a Google account as
# a text provider. It is an "installed application" client (Google does not
# treat that secret as confidential), but it belongs to Google's Antigravity
# IDE rather than to this project, so it is not committed here. Copy the two
# values from the project Patchbay's Google backend is based on:
# https://github.com/badrisnarayanan/antigravity-claude-proxy (src/constants.js,
# OAUTH_CONFIG), or from your own Antigravity installation.
PATCHBAY_GOOGLE_CLIENT_ID=
PATCHBAY_GOOGLE_CLIENT_SECRET=
